---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Type sample — Joan + Source Serif"
      description="Specimen page documenting the Joan headings + Source Serif 4 body pairing used site-wide."
    />
    <meta name="robots" content="noindex" />
    <style>
      main.specimen {
        width: 720px;
      }
      .note {
        padding: 1em 1.25em;
        margin: 0 0 2em 0;
        background: rgb(var(--gray-light));
        border-radius: 8px;
        font-size: 0.95em;
        color: rgb(var(--gray-dark));
      }
      section {
        margin-bottom: 3em;
      }
      section > h2:first-child {
        margin-bottom: 1em;
      }
      .hierarchy p {
        margin: 0 0 0.75em 0;
        font-family: var(--display);
        font-weight: 400;
      }
      .hierarchy .size-only {
        font-size: 1.8em;
      }
      .hierarchy .size-tracking {
        font-size: 1.8em;
        letter-spacing: -0.02em;
      }
      .hierarchy .size-tracking-color {
        font-size: 1.8em;
        letter-spacing: -0.02em;
        color: rgb(var(--accent));
      }
      .ab {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2em;
      }
      .tracking-steps {
        display: flex;
        flex-direction: column;
        gap: 1.75em;
      }
      .tracking-step {
        padding-bottom: 1.75em;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .tracking-step:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
      .tracking-demo {
        margin: 0 0 0.3em 0;
        font-family: var(--display);
        font-weight: 600; /* matches the live, browser-synthesized heading weight */
        color: rgb(var(--heading));
        line-height: 1.2;
      }
      .tracking-demo--h1 {
        font-size: 2.4em;
      }
      .tracking-demo--h3 {
        font-size: 1.5em;
      }
      .track-current {
        letter-spacing: -0.015em;
      }
      .track-1 {
        letter-spacing: -0.005em;
      }
      .track-2 {
        letter-spacing: 0em;
      }
      .track-3 {
        letter-spacing: 0.01em;
      }
      .wordmark-compare {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5em;
      }
      .wordmark {
        margin: 0;
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.2em;
        letter-spacing: -0.005em;
        color: rgb(var(--accent));
      }
      .wordmark.uppercase {
        text-transform: uppercase;
        letter-spacing: 0.02em; /* all-caps reads better with positive tracking, not Joan's default negative */
      }
      .wordmark.small-caps {
        font-variant-caps: small-caps;
      }
      .nav-compare {
        display: flex;
        flex-direction: column;
        gap: 1.5em;
      }
      .nav-preview {
        display: flex;
        align-items: center;
        gap: 1.4em;
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: rgb(var(--gray));
      }
      .nav-preview .active {
        color: rgb(var(--accent));
      }
      .nav-preview.joan {
        font-family: var(--display);
      }
      .nav-preview.tighten-1 {
        letter-spacing: 0.03em;
      }
      .nav-preview.tighten-2 {
        letter-spacing: 0em;
      }
      .nav-preview.tighten-3 {
        letter-spacing: -0.02em;
      }
      @media (max-width: 720px) {
        main.specimen {
          width: auto;
        }
        .ab,
        .wordmark-compare {
          grid-template-columns: 1fr;
        }
      }
      .ab h3 {
        margin-bottom: 0.25em;
      }
      .ab .source-serif {
        font-family: var(--serif);
        font-weight: 600;
      }
      .label {
        margin: 0 0 0.5em 0;
        font-size: 0.75em;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgb(var(--gray));
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="specimen">
      <h1>Type sample</h1>
      <p class="note">
        <strong>Joan ships one weight (400) and no italic.</strong> Headings are set at{' '}
        <code>font-weight: 600</code>, which the browser synthesizes since Joan has no real semibold
        — accepted as a workaround rather than dropping to size/tracking/color alone. Body copy
        stays on Source Serif 4, which keeps its full weight and italic range natively.
      </p>

      <section>
        <h2>Scale stack</h2>
        <h1>Some ideas take longer to say plainly</h1>
        <h2>The long version is usually the first draft</h2>
        <h3>Editing is where the argument actually happens</h3>
      </section>

      <section>
        <h2>Heading tracking (looser mockups)</h2>
        <div class="tracking-steps">
          <div class="tracking-step">
            <p class="label">-0.015em (previous)</p>
            <p class="tracking-demo tracking-demo--h1 track-current">
              Some ideas take longer to say plainly
            </p>
            <p class="tracking-demo tracking-demo--h3 track-current">
              Editing is where the argument happens
            </p>
          </div>
          <div class="tracking-step">
            <p class="label">-0.005em (current, global default)</p>
            <p class="tracking-demo tracking-demo--h1 track-1">
              Some ideas take longer to say plainly
            </p>
            <p class="tracking-demo tracking-demo--h3 track-1">
              Editing is where the argument happens
            </p>
          </div>
          <div class="tracking-step">
            <p class="label">0em (normal)</p>
            <p class="tracking-demo tracking-demo--h1 track-2">
              Some ideas take longer to say plainly
            </p>
            <p class="tracking-demo tracking-demo--h3 track-2">
              Editing is where the argument happens
            </p>
          </div>
          <div class="tracking-step">
            <p class="label">0.01em (loosest)</p>
            <p class="tracking-demo tracking-demo--h1 track-3">
              Some ideas take longer to say plainly
            </p>
            <p class="tracking-demo tracking-demo--h3 track-3">
              Editing is where the argument happens
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2>Heading and body, in rhythm</h2>
        <p>
          This is the pairing where most of the judgment happens — not the isolated scale above, but
          a heading followed immediately by a paragraph, the way an actual post reads.
        </p>

        <h2>A second heading, same test</h2>
        <p>
          Joan's letterforms are wide and a little formal; sitting a body paragraph in Source Serif
          right underneath asks whether the transition feels like one voice changing register, or
          two unrelated typefaces sharing a page.
        </p>

        <h2>One more, to be sure</h2>
        <p>
          Repetition here is deliberate — a single instance can look fine by accident. Three in a
          row is closer to what a real post feels like scrolling past.
        </p>
      </section>

      <section class="hierarchy">
        <h2>Hierarchy without weight</h2>
        <p class="size-only">Size alone</p>
        <p class="size-tracking">Size, tightened letter-spacing</p>
        <p class="size-tracking-color">Size, tracking, and accent color</p>
      </section>

      <section>
        <h2>Body specimen</h2>
        <p>
          A paragraph needs to carry <strong>bold</strong>,{' '}
          <em>italic</em>, a <a href="/">link</a>, and inline{' '}
          <code>code</code> without any of them looking borrowed from elsewhere. Source Serif 4 handles
          all four natively, so none of this is faux-styled.
        </p>
      </section>

      <section>
        <h2>Blockquote and list</h2>
        <blockquote>
          <p>
            A blockquote already leans on Source Serif's italic — no display face involved here.
          </p>
        </blockquote>
        <ul>
          <li>List markers and body copy: Source Serif, as elsewhere on the site</li>
          <li>Only headings switch to Joan</li>
          <li>Confirms the two don't collide inside mixed content</li>
        </ul>
      </section>

      <section>
        <h2>Site title casing</h2>
        <div class="wordmark-compare">
          <div>
            <p class="label">Title case (current)</p>
            <p class="wordmark">Perry Wang</p>
          </div>
          <div>
            <p class="label">All caps</p>
            <p class="wordmark uppercase">Perry Wang</p>
          </div>
          <div>
            <p class="label">Small caps (lower)</p>
            <p class="wordmark small-caps">perry wang</p>
          </div>
          <div>
            <p class="label">Small caps (title case)</p>
            <p class="wordmark small-caps">Perry Wang</p>
          </div>
        </div>
      </section>

      <section>
        <h2>Nav links</h2>
        <div class="nav-compare">
          <div>
            <p class="label">Current (Source Serif)</p>
            <div class="nav-preview">
              <span class="active">Home</span>
              <span>About</span>
              <span>RSS</span>
            </div>
          </div>
          <div>
            <p class="label">Joan, 0.06em (untightened)</p>
            <div class="nav-preview joan">
              <span class="active">Home</span>
              <span>About</span>
              <span>RSS</span>
            </div>
          </div>
          <div>
            <p class="label">Joan, 0.03em</p>
            <div class="nav-preview joan tighten-1">
              <span class="active">Home</span>
              <span>About</span>
              <span>RSS</span>
            </div>
          </div>
          <div>
            <p class="label">Joan, 0em</p>
            <div class="nav-preview joan tighten-2">
              <span class="active">Home</span>
              <span>About</span>
              <span>RSS</span>
            </div>
          </div>
          <div>
            <p class="label">Joan, -0.02em</p>
            <div class="nav-preview joan tighten-3">
              <span class="active">Home</span>
              <span>About</span>
              <span>RSS</span>
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2>Side by side</h2>
        <div class="ab">
          <div>
            <p class="label">Joan, 600 synthesized (current)</p>
            <h3>The quiet type does more work</h3>
          </div>
          <div>
            <p class="label">Source Serif 4, 600 (previous)</p>
            <h3 class="source-serif">The quiet type does more work</h3>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
